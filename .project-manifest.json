{
  "project_shape": "backend",
  "modules": [
    {
      "id": "app",
      "path": "doorfolio/app.py",
      "responsibility": "注册该服务公开数据入口"
    },
    {
      "id": "http_service",
      "path": "doorfolio/http_service.py",
      "responsibility": "限定请求方法、内容体积和 JSON 传输边界"
    },
    {
      "id": "contract",
      "path": "doorfolio/contract.py",
      "responsibility": "严格字段、范围及标识去重"
    },
    {
      "id": "segment",
      "path": "doorfolio/segment.py",
      "responsibility": "段内按位换号"
    },
    {
      "id": "walk",
      "path": "doorfolio/walk.py",
      "responsibility": "分日分支推演"
    },
    {
      "id": "lookup",
      "path": "doorfolio/lookup.py",
      "responsibility": "双向档案查找"
    },
    {
      "id": "folio",
      "path": "doorfolio/folio.py",
      "responsibility": "换号册街廓授权、偏移区间运算、需求裁剪与片段校验"
    },
    {
      "id": "registry",
      "path": "doorfolio/registry.py",
      "responsibility": "进程内换号册登记、分页交付与完整度判定"
    },
    {
      "id": "bookwalk",
      "path": "doorfolio/bookwalk.py",
      "responsibility": "带交付证据与缺页见证的分日推演"
    },
    {
      "id": "folio_lookup",
      "path": "doorfolio/folio_lookup.py",
      "responsibility": "换号册前查与显式新号反查归约"
    }
  ],
  "workflows": [
    {
      "id": "forward",
      "name": "按有效日推演门牌",
      "entry": "POST /doorfolio/forward",
      "success": "苇岸道 13 号得到旧栈巷 31 号与西汊路 42 号，保留不同登记路径",
      "failure": "对照 examples/forward.invalid.json 返回 400 和错误说明",
      "verification": "python3 -B -m examples.check forward",
      "steps": [
        "接收 /doorfolio/forward",
        "按有效日推演门牌",
        "返回计算后的证据或合成结果"
      ],
      "module_ids": [
        "app",
        "http_service",
        "lookup",
        "segment",
        "walk",
        "contract"
      ]
    },
    {
      "id": "reverse",
      "name": "从现门牌反查前址",
      "entry": "POST /doorfolio/reverse",
      "success": "西汊路 42 号反查到苇岸道 13 号，依次引用 N9、N7",
      "failure": "对照 examples/reverse.invalid.json 返回 400 和错误说明",
      "verification": "python3 -B -m examples.check reverse",
      "steps": [
        "接收 /doorfolio/reverse",
        "从现门牌反查前址",
        "返回计算后的证据或合成结果"
      ],
      "module_ids": [
        "app",
        "http_service",
        "lookup",
        "segment",
        "walk",
        "contract"
      ]
    },
    {
      "id": "inspect",
      "name": "给出规则冲突及证据",
      "entry": "POST /doorfolio/inspect",
      "success": "N7 和 N8 的旧号重叠，首个共同门号为 13",
      "failure": "对照 examples/inspect.invalid.json 返回 400 和错误说明",
      "verification": "python3 -B -m examples.check inspect",
      "steps": [
        "接收 /doorfolio/inspect",
        "给出规则冲突及证据",
        "返回计算后的证据或合成结果"
      ],
      "module_ids": [
        "app",
        "http_service",
        "lookup",
        "segment",
        "contract"
      ]
    },
    {
      "id": "booklet_open",
      "name": "开册并裁剪前后路径所需配对",
      "entry": "POST /doorfolio/booklet_open",
      "success": "两天两路汇流场景开出 P1-P4 四页，每则公告只含路径实际经过的偏移区间",
      "failure": "重复开册、非法街廓或等长不符返回 400 和错误说明",
      "verification": "python3 -B -m examples.folio_check",
      "steps": [
        "接收 booklet_open",
        "按街廓与日期窗口算术裁剪 needs",
        "返回页清单与偏移需求，不逐门生成"
      ],
      "module_ids": [
        "app",
        "http_service",
        "registry",
        "folio",
        "segment",
        "contract"
      ]
    },
    {
      "id": "booklet_deliver",
      "name": "分页交付换号片段",
      "entry": "POST /doorfolio/booklet_deliver",
      "success": "仅 needs 内位置对齐片段被接收，缺页随交付减少",
      "failure": "夹带不需要的配对、越页引证或重叠交付返回 400",
      "verification": "python3 -B -m examples.folio_check",
      "steps": [
        "接收 booklet_deliver",
        "校验片段街名、步长、偏移与所属页",
        "落库并返回缺失页"
      ],
      "module_ids": [
        "app",
        "http_service",
        "registry",
        "folio",
        "contract"
      ]
    },
    {
      "id": "booklet_query",
      "name": "册内带证据前查与显式新号反查",
      "entry": "POST /doorfolio/booklet_forward 与 /doorfolio/booklet_reverse",
      "success": "缺渡口街页时旧栈巷只报一路并点名 P2/P4，补齐后两路同址双路径齐备",
      "failure": "越权街廓返回 out_of_scope，缺页返回 incomplete 而非伪完整答案",
      "verification": "python3 -B -m examples.folio_check",
      "steps": [
        "接收册内查询",
        "按交付证据分日推演并记录缺页见证",
        "区分 unchanged、mapped、incomplete、out_of_scope"
      ],
      "module_ids": [
        "app",
        "http_service",
        "folio_lookup",
        "bookwalk",
        "registry",
        "folio",
        "segment",
        "contract"
      ]
    }
  ],
  "complexity": {
    "mechanisms": [
      "段内按位换号",
      "分日分支推演",
      "双向档案查找",
      "同日重叠见证",
      "偏移区间算术裁剪",
      "分页证据与缺页见证",
      "进程内册隔离"
    ]
  }
}
