{
  "language": "Python",
  "project_shape": "backend",
  "source_extensions": [
    ".py"
  ],
  "testing": "deferred",
  "build_command": "python3 -B -c \"from pathlib import Path; [compile(p.read_bytes(),str(p),'exec') for d in ('doorfolio', 'examples') for p in Path(d).glob('*.py')]\"",
  "workflow_checks": [
    {
      "workflow_id": "forward",
      "command": "python3 -B -m examples.check forward"
    },
    {
      "workflow_id": "reverse",
      "command": "python3 -B -m examples.check reverse"
    },
    {
      "workflow_id": "inspect",
      "command": "python3 -B -m examples.check inspect"
    },
    {
      "workflow_id": "booklet_open",
      "command": "python3 -B -m examples.folio_check"
    },
    {
      "workflow_id": "booklet_deliver",
      "command": "python3 -B -m examples.folio_check"
    },
    {
      "workflow_id": "booklet_query",
      "command": "python3 -B -m examples.folio_check"
    },
    {
      "workflow_id": "booklet_scenario",
      "command": "python3 -B -m examples.folio_scenario"
    },
    {
      "workflow_id": "booklet_edges",
      "command": "python3 -B -m examples.folio_edges"
    }
  ]
}
